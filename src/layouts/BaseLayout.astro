---
import '../styles/global.css';
import Navbar from "../components/layout/Navbar.astro";
import CursorFollower from "../components/CursorFollower.astro";
import InteractiveParticles from "../components/InteractiveParticles.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title?: string;
  lang?: string;
}

const {
  title = 'Portfolio',
  lang = 'sk',
} = Astro.props;

const htmlLang = lang === 'en' ? 'en-US' : 'sk-SK';
---

<!doctype html>
<html lang={htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title}</title>
  

  <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;700&display=swap"
  rel="stylesheet"
/>
</head>

<body class="bg-black text-white">

  <InteractiveParticles />
  <CursorFollower />
  <ThemeToggle />
  <Navbar />

  <main>
    <slot />
  </main>

  <script src="../scripts/scroll-animations.js"></script>

</body>
</html>