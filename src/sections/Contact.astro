---
import Container from "../components/Container.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Button from "../components/Button.astro";
import { getTranslation } from "../i18n/index";

interface Props {
  lang?: string;
}

const { lang = "sk" } = Astro.props;

const t = (key: string) => getTranslation(lang, key);
---

<section id="contact" class="py-32 relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-gradient-to-r from-yellow-400/10 to-cyan-400/10 rounded-full blur-3xl"></div>
  
  <Container>
    <div class="scroll-reveal">
      <SectionTitle subtitle={t('contact.subtitle')} title={t('contact.title')} />
    </div>

    <div class="mx-auto max-w-2xl mt-16">
      <div class="rounded-2xl glass gradient-border p-12 scroll-reveal">
        <form
          action="https://formspree.io/f/xljrngor"
          method="POST"
          class="space-y-6"
        >
          <div>
            <label for="name" class="block text-sm font-semibold mb-2">
              {t('contact.name')}
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full rounded-lg border border-neutral-700 bg-neutral-950/80 px-4 py-3 text-white placeholder-neutral-500 focus:border-white focus:outline-none focus:ring-2 focus:ring-white/20"
              placeholder={t('contact.namePlaceholder')}
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold mb-2">
              {t('contact.email')}
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full rounded-lg border border-neutral-700 bg-neutral-950/80 px-4 py-3 text-white placeholder-neutral-500 focus:border-white focus:outline-none focus:ring-2 focus:ring-white/20"
              placeholder={t('contact.emailPlaceholder')}
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold mb-2">
              {t('contact.message')}
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows={6}
              class="w-full rounded-lg border border-neutral-700 bg-neutral-950/80 px-4 py-3 text-white placeholder-neutral-500 focus:border-white focus:outline-none focus:ring-2 focus:ring-white/20 resize-none"
              placeholder={t('contact.messagePlaceholder')}
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full rounded-lg bg-white px-6 py-3 font-semibold text-black transition hover:bg-neutral-200 hover-lift glow-accent"
          >
            {t('contact.send')}
          </button>
        </form>

        <div class="mt-12 border-t border-neutral-800 pt-12">
          <h3 class="heading-font mb-8 text-2xl font-bold">{t('contact.connect')}</h3>
          <div class="grid gap-4 sm:grid-cols-2">
            <a
              href="tel:+421915382092"
              class="rounded-lg border border-neutral-800 bg-neutral-900/50 px-6 py-4 transition hover:border-neutral-700 hover:bg-neutral-800 hover-lift group"
            >
              <p class="text-sm text-neutral-500 mb-1 group-hover:text-neutral-400">Phone</p>
              <p class="font-semibold group-hover:text-white">+421 915 382 092</p>
            </a>
            <a
              href="mailto:simon07meszaros@gmail.com"
              class="rounded-lg border border-neutral-800 bg-neutral-900/50 px-6 py-4 transition hover:border-neutral-700 hover:bg-neutral-800 hover-lift group"
            >
              <p class="text-sm text-neutral-500 mb-1 group-hover:text-neutral-400">{t('contact.emailLabel')}</p>
              <p class="font-semibold group-hover:text-white">simon07meszaros@gmail.com</p>
            </a>
            <a
              href="https://instagram.com/simonvideography"
              target="_blank"
              class="rounded-lg border border-neutral-800 bg-neutral-900/50 px-6 py-4 transition hover:border-neutral-700 hover:bg-neutral-800 hover-lift group"
            >
              <p class="text-sm text-neutral-500 mb-1 group-hover:text-neutral-400">{t('contact.instagramLabel')}</p>
              <p class="font-semibold group-hover:text-white">@simonvideography</p>
            </a>
            <a
              href="https://linkedin.com/in/SimonMeszaros"
              target="_blank"
              class="rounded-lg border border-neutral-800 bg-neutral-900/50 px-6 py-4 transition hover:border-neutral-700 hover:bg-neutral-800 hover-lift group"
            >
              <p class="text-sm text-neutral-500 mb-1 group-hover:text-neutral-400">{t('contact.linkedinLabel')}</p>
              <p class="font-semibold group-hover:text-white">Simon Mészáros</p>
            </a>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
