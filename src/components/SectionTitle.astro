---
interface Props {
    title: string
    subtitle?: string
}

const { title, subtitle } = Astro.props
---

<div class="mb-12">
    {subtitle && (
        <p class="mb-2 uppercase tracking-[0.25em] text-neutral-500">
            {subtitle}
        </p>
    )}

    <h2 class="text-4xl font-bold">
        {title}
    </h2>
</div>